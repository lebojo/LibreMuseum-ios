      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musée injoignable"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        }
      }
    },
