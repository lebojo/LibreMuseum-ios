      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune langue disponible"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Permanent collection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection permanente"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche"
          }
        }
      }
    },
    "Search by title, artist and medium will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche par titre, artiste et technique arrivera ici."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        }
      }
    },
    "Space used": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace occupé"
          }
        }
      }
    },
    "The app compares this fingerprint with the server's at every launch and only downloads what changed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app compare cette empreinte à celle du serveur à chaque lancement et ne retélécharge que ce qui a changé."
          }
        }
      }
    },
    "The museum has not published any exhibition yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le musée n'a pas encore publié d'exposition."
          }
        }
      }
    },
    "The museum is unreachable. Content already downloaded stays available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le musée est injoignable. Le contenu déjà téléchargé reste disponible."
          }
        }
      }
    },
    "The server address is invalid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse du serveur est invalide."
          }
        }
      }
    },
    "The server answered %lld.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu %lld."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "Unexpected answer from the server: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse inattendue du serveur : %@"
          }
        }
      }
    },
    "Until %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'au %@"
          }
        }
      }
    }
  },
  "version": "1.3"
}
