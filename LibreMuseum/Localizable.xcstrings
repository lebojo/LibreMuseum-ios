{
  "sourceLanguage": "en",
  "strings": {
    "%lld%%": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %%"
          }
        }
      }
    },
    "By default the app follows your phone's language when the museum offers it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, l'app suit la langue du téléphone si le musée la propose."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Content": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu"
          }
        }
      }
    },
    "Content version": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version du contenu"
          }
        }
      }
    },
    "Content will be downloaded again next time you open it. Your language is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sera retéléchargé à la prochaine consultation. Votre langue est conservée."
          }
        }
      }
    },
    "Delete all downloaded content?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer tout le contenu téléchargé ?"
          }
        }
      }
    },
    "Delete everything": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout effacer"
          }
        }
      }
    },
    "Download every image and audio guide before your visit: reception is poor inside the galleries.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez l'ensemble des images et des audioguides avant votre visite : les salles captent rarement."
          }
        }
      }
    },
    "Download everything": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout télécharger"
          }
        }
      }
    },
    "Exhibitions": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expositions"
          }
        }
      }
    },
    "Fetching content from the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération du contenu depuis le serveur."
          }
        }
      }
    },
    "Floor plans and artwork locations will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plans d'étage et la position des œuvres arriveront ici."
          }
        }
      }
    },
    "From %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du %@"
          }
        }
      }
    },
